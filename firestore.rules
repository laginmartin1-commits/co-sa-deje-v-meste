rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Web môže iba čítať. Zapisuje len bot cez Admin SDK (ten pravidlá obchádza).
    match /cities/{cityId} {
      allow read: if true;
      allow write: if false;
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
